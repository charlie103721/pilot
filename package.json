{
  "name": "pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pilot — macOS desktop assistant that observes one selected window and answers spoken questions.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.typecheck.json && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --build tsconfig.json && pnpm -r --if-present run build:app",
    "dev": "pnpm --filter @pilot/desktop run dev",
    "start": "pnpm --filter @pilot/desktop run start",
    "package": "pnpm --filter @pilot/desktop run package",
    "smoke": "pnpm --filter @pilot/desktop run smoke",
    "demo:interaction": "pnpm build && pnpm --filter @pilot/interaction run demo",
    "demo:envelope": "pnpm build && pnpm --filter @pilot/interaction run demo:envelope",
    "demo:permissions": "pnpm --filter @pilot/desktop run demo:permissions",
    "demo:windows": "pnpm --filter @pilot/desktop run demo:windows",
    "demo:conversation": "pnpm --filter @pilot/desktop run demo:conversation",
    "demo:agent": "pnpm --filter @pilot/desktop run demo:agent",
    "demo:observe": "pnpm --filter @pilot/desktop run demo:observe",
    "demo:look": "pnpm --filter @pilot/desktop run demo:look",
    "demo:ask": "pnpm --filter @pilot/desktop run demo:ask",
    "demo:talk": "pnpm --filter @pilot/desktop run demo:talk",
    "demo:speak": "pnpm --filter @pilot/desktop run demo:speak",
    "demo:flow": "pnpm --filter @pilot/desktop run demo:flow",
    "demo:voice": "pnpm build && pnpm --filter @pilot/interaction run demo:voice",
    "demo:response": "pnpm build && pnpm --filter @pilot/interaction run demo:response",
    "demo:interrupt": "pnpm build && pnpm --filter @pilot/interaction run demo:interrupt",
    "clean": "tsc --build tsconfig.json --clean && rm -rf apps/desktop/dist apps/desktop/release apps/desktop/resources"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
