{
  "name": "pilot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pilot — macOS desktop assistant that observes one selected window and answers spoken questions.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --build tsconfig.json",
    "demo:interaction": "pnpm build && pnpm --filter @pilot/interaction run demo",
    "clean": "tsc --build tsconfig.json --clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
