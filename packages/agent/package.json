{
  "name": "@pilot/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pi Agent Core runtime: provider-independent agent session backed by @earendil-works/pi-agent-core.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo": "node demo/observe-screen-demo.mjs",
    "demo:capability": "node demo/capability-gate-demo.mjs",
    "demo:observe": "node demo/observe-screen-tool-demo.mjs",
    "demo:visual-context": "node demo/visual-context-demo.mjs",
    "demo:compaction": "node demo/compaction-demo.mjs",
    "demo:persistence": "node demo/persistence-demo.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.1",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-session-backend-sqlite-node": "0.84.1",
    "@pilot/platform": "workspace:*",
    "@pilot/shared": "workspace:*",
    "typebox": "1.3.7",
    "zod": "4.4.3"
  }
}
