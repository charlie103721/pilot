{
  "name": "@pilot/platform-mac",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "macOS platform implementation: embedded Swift helper and its framed stdio transport.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "demo": "node test/demo.ts",
    "demo:permissions": "node test/demo-permissions.ts",
    "demo:accessibility": "node test/demo-accessibility.ts",
    "demo:speech": "node test/demo-speech.ts",
    "demo:capture": "node test/demo-capture.ts",
    "demo:hotkey": "node test/demo-hotkey.ts",
    "helper:build": "swift build --package-path native -c debug",
    "helper:build:release": "swift build --package-path native -c release",
    "helper:test": "swift test --package-path native"
  },
  "dependencies": {
    "@pilot/platform": "workspace:*",
    "@pilot/shared": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@pilot/observation": "workspace:*",
    "@pilot/interaction": "workspace:*"
  }
}
