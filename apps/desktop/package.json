{
  "name": "@pilot/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "Pilot",
  "description": "Electron desktop shell: lifecycle, single-instance lock, menu bar item, floating panel, and the validated renderer IPC surface.",
  "main": "./dist/main/index.js",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.js",
    "typecheck": "tsc -p tsconfig.check.json && tsc -p tsconfig.renderer.json",
    "build:helper": "node scripts/build-helper.js",
    "build:app": "node scripts/build-helper.js && electron-vite build",
    "dev": "electron-vite dev",
    "demo:permissions": "node scripts/permissions-demo.js",
    "demo:windows": "node scripts/windows-demo.js",
    "demo:conversation": "node scripts/conversation-demo.js",
    "demo:agent": "node scripts/agent-demo.js",
    "demo:observe": "node scripts/observe-demo.js",
    "demo:look": "node scripts/look-demo.js",
    "demo:ask": "node scripts/ask-demo.js",
    "demo:talk": "node scripts/talk-demo.js",
    "demo:speak": "node scripts/speak-demo.js",
    "demo:flow": "node scripts/flow-demo.js",
    "demo:interrupt-flow": "node scripts/interrupt-demo.js",
    "demo:memory": "node scripts/memory-demo.js",
    "demo:local": "node scripts/local-demo.js",
    "demo:failure": "node scripts/failure-demo.js",
    "demo:codex": "node scripts/codex-demo.js",
    "package": "node scripts/ensure-electron.js --require && pnpm run build:app && electron-builder --dir --config electron-builder.yml && node scripts/verify-bundle.js",
    "verify:bundle": "node scripts/verify-bundle.js",
    "start": "electron .",
    "smoke": "xvfb-run -a node scripts/smoke.js",
    "smoke:packaged": "xvfb-run -a node scripts/smoke.js --packaged"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@pilot/agent": "workspace:*",
    "@pilot/interaction": "workspace:*",
    "@pilot/observation": "workspace:*",
    "@pilot/platform": "workspace:*",
    "@pilot/platform-mac": "workspace:*",
    "@pilot/shared": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "vite": "^7.3.6"
  }
}
