<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Development entitlements.

  Pilot is not App-Sandboxed: ScreenCaptureKit over an arbitrary user-chosen
  window, system-wide Accessibility and a global push-to-talk hotkey are all
  outside what the sandbox grants. Access is gated by TCC prompts instead, which
  is the same protection the user actually sees.

  The two JIT entitlements are Electron's baseline requirements; the audio-input
  entitlement is what lets a hardened-runtime build reach the microphone. They
  only take effect once a build is signed with a real identity, which a
  development build is not.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
